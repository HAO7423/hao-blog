---
import path from "node:path";

interface Props {
	id?: string;
	src: string;
	class?: string;
	alt?: string;
	position?: string;
	basePath?: string;
}

import { Image } from "astro:assets";
import { url } from "../../utils/url-utils";

const { id, src, alt, position = "center", basePath = "/" } = Astro.props;
const className = Astro.props.class;

const isLocal = !(
	src.startsWith("/") ||
	src.startsWith("http") ||
	src.startsWith("https") ||
	src.startsWith("data:")
);
const isPublic = src.startsWith("/");

// TODO temporary workaround for images dynamic import
// https://github.com/withastro/astro/issues/3373
// biome-ignore lint/suspicious/noImplicitAnyLet: <check later>
let img;
if (isLocal) {
	// ⚠️ DO NOT narrow this glob to image extensions.
	//
	// It looks like a bug that "../../**" sweeps every .css / .styl / .ts file under src/
	// into the Rollup module graph, but that side effect is LOAD-BEARING: nothing else in
	// the project imports src/styles/*, and Vite hoists the CSS of glob-matched modules into
	// the page stylesheet. Narrowing this pattern therefore removes main.css, markdown.css,
	// variables.styl etc. from the build entirely — the site still builds and still looks
	// "mostly right", but every custom component class silently disappears:
	// .card-base, .btn-plain, .link, .float-panel, .meta-icon, .custom-md, ...
	// i.e. cards lose their background/rounding, buttons lose their styling and post
	// content loses its markdown typography.
	//
	// The build flakiness that this glob used to cause ("The `link` class does not exist",
	// roughly 1 build in 5) has been fixed at its real source instead: the cross-file
	// `@apply link` / `@apply btn-regular-dark` in src/styles/markdown.css were expanded to
	// the equivalent utilities, so no style file depends on another's compile order.
	const files = import.meta.glob<ImageMetadata>("../../**", {
		import: "default",
	});
	let normalizedPath = path
		.normalize(path.join("../../", basePath, src))
		.replace(/\\/g, "/");
	const file = files[normalizedPath];
	if (!file) {
		console.error(
			`\n[ERROR] Image file not found: ${normalizedPath.replace("../../", "src/")}`,
		);
	}
	img = await file();
}

const imageClass = "w-full h-full object-cover";
const imageStyle = `object-position: ${position}`;
---
<div id={id} class:list={[className, 'overflow-hidden relative']}>
    <div class="transition absolute inset-0 dark:bg-black/10 bg-opacity-50 pointer-events-none"></div>
    {isLocal && img && <Image src={img} alt={alt || ""} class={imageClass} style={imageStyle}/>}
    {!isLocal && <img src={isPublic ? url(src) : src} alt={alt || ""} class={imageClass} style={imageStyle}/>}
</div>
